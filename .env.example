# Copy to .env in the project root. Used by Django and Docker Compose. Never commit .env.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Kolkata

POSTGRES_DB=concord
POSTGRES_USER=concord
POSTGRES_PASSWORD=change-this-password
# Remove this line to fall back to SQLite (UI work only, not for billing tests or the demo).
DATABASE_URL=postgres://concord:change-this-password@localhost:5432/concord

# Where links in emails point.
FRONTEND_URL=http://localhost:5173

# Emails print to the backend terminal unless SMTP is configured below.
DEFAULT_FROM_EMAIL=Concord <no-reply@concord.local>
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
